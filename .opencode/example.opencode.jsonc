{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "google/gemma-3n-e4b": {
          "name": "Gemma 3n-e4b"
        },
        "zai-org/glm-4.6-flash": {
          "name": "GLM 4.6 Vision"
        },
        "qwen3-14b": {
          "name": "Qwen3 14b"
        },
        "ibm/granite-4-h-tiny": {
          "name": "Granite 4 H Tiny"
        },
      }
    }
  },
  "agent": {
    "development-manager": {
      "mode": "primary",
      "permission": {
        "task": {
          "*": "allow",
          "*-developer": "allow",
          "context-manager": "allow"
        },
        "skill": {
          "*": "deny",
        }
      }
    }
  }
}
